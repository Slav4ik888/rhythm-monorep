server {
    server_name rhy.thm.su;
    charset UTF-8;
    set $root_path /var/www/vtempe/data/rhythm2/packages/frontend/build;
    disable_symlinks if_not_owner from=$root_path;
    location / {
        root $root_path;
        try_files $uri $uri/ /index.html;  # ← Важно! Fallback на index.html
        add_header Cache-Control "no-cache, no-store";
        disable_symlinks off;
        access_log /var/www/httpd-logs/rhy.thm.su.access.log ;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:7575;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Client-Version $http_x_client_version;
        proxy_read_timeout 300s;  # 5 минут — Google Sheets может долго отвечать на большие таблицы
        proxy_connect_timeout 10s;
        proxy_send_timeout 10s;
    }
    include /usr/local/ispmgr/etc/nginx.inc;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/rhy.thm.su/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/rhy.thm.su/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = rhy.thm.su) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name rhy.thm.su;
    listen 159.253.19.168;
    return 404; # managed by Certbot


}
