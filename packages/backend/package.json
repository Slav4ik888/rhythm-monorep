{
  "name": "@rhythm/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Информационная панель руководителя «Ритм» — бэкенд API",
  "scripts": {
    "build": "concurrently \"npm run copy\" \"npm run tsc\"",
    "tsc": "tsc -p tsconfig.prod.json",
    "copy": "copyfiles -u 1 src/assets/**/* src/assets/**/**/* src/downloads/**/* src/downloads/**/**/* src/libs/emails/templates/* server",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "start": "node server/main.js",
    "test:shared": "jest --detectOpenHandles --config ./config/jest/jest.config-shared.ts",
    "test:validators": "jest --detectOpenHandles --config ./config/jest/jest.config-validators.ts",
    "test:unit": "jest --config ./config/jest/jest.config.ts",
    "test:emulators": "RUN_EMULATOR_TESTS=1 jest --config ./config/jest/jest.config-emulators.ts",
    "test": "npm run test:unit && npm run test:shared && npm run test:validators",
    "seed:emulators": "FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 ts-node src/scripts/seed-emulators.ts"
  },
  "author": "Vyacheslav",
  "license": "ISC",
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-fastify": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "1.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.12",
    "firebase": "^11.9.1",
    "firebase-admin": "12.6.0",
    "juice": "^11.0.0",
    "nodemailer": "^6.9.15",
    "nodemailer-html-to-text": "^3.2.0",
    "nodemailer-smtp-transport": "^2.4.2",
    "nodemailer-stub-transport": "^1.1.0",
    "path": "^0.12.7",
    "pug": "^3.0.3",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "regenerator-runtime": "0.14.1",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.29",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.16",
    "@types/nodemailer-smtp-transport": "^2.7.8",
    "@types/nodemailer-stub-transport": "^1.1.8",
    "@types/pug": "^2.0.10",
    "@types/redis": "^4.0.10",
    "@types/uuid": "^10.0.0",
    "babel-jest": "29.7.0",
    "concurrently": "^9.0.1",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
