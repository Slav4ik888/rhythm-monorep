[Unit]
Description=NodeJS Server for Rhythm (NestJS)
# Бэкенд не должен стартовать раньше сети и Redis:
# в production при недоступном Redis сервер завершится с ошибкой (см. src/libs/redis/init.ts).
After=network.target redis.service

[Service]
Type=simple
Restart=always
# RestartSec=5
PIDFile=/run/rhythm-server.pid

# ВАЖНО: поправьте абсолютные пути под свой сервер (монорепозиторий).
# Запускаем NestJS-вход (server/main.js), а не Koa (server/index.js).
WorkingDirectory=/var/www/vtempe/data/rhythm2/packages/backend
ExecStart=/root/.nvm/versions/node/v20.19.2/bin/node /var/www/vtempe/data/rhythm2/packages/backend/server/main.js

# Переменные окружения (см. README.md — раздел «Переменные окружения»)
Environment=NODE_ENV=production
Environment=PORT=7575
Environment=REDIS_URL=redis://localhost:6379
Environment=SITE_URL=https://rhy.thm.su
# Секреты (web-конфиг Firebase, SMTP, пароль логов) хранятся отдельно в файле:
#   /etc/rhythm/rhythm-server.env
# Класть туда ТОЛЬКО: FIREBASE_API_KEY/AUTH_DOMAIN/STORAGE_BUCKET/MESSAGING_SENDER_ID/APP_ID,
# SMTP_USER/SMTP_PASS, LOGS_PASS. NODE_ENV/PORT/REDIS_URL/SITE_URL уже заданы выше.
# Креды Admin SDK (privateKey) НЕ сюда — их читает GOOGLE_APPLICATION_CREDENTIALS ниже.
# Формат: KEY=value (без кавычек). Права: root:root 600.
EnvironmentFile=/etc/rhythm/rhythm-server.env
# JSON-файл сервисного аккаунта Firebase (privateKey внутри, с реальными \n в JSON-строке).
# privateKey нельзя держать в EnvironmentFile: systemd съедает обратный слэш в \n и портит ключ.
Environment=GOOGLE_APPLICATION_CREDENTIALS=/etc/rhythm/firebase-adminsdk.json

[Install]
WantedBy=multi-user.target
