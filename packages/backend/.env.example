# Шаблон переменных окружения бэкенда.
# Локально: скопируйте в .env и заполните: cp .env.example .env
# На сервере: скопируйте в /etc/rhythm/rhythm-server.env (права 600) —
# его читает systemd (см. rhythm-server.service, EnvironmentFile=).

# --- Firebase Admin SDK (Service Account) ---
# Значения берутся из Firebase Console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# ВАЖНО: приватный ключ указывается на ОДНОЙ строке, переносы строк — литеральные \n.
FIREBASE_PRIVATE_KEY=

# --- Firebase web-конфиг (client SDK, используется бэкендом для firebase/auth) ---
# Firebase Console → Project settings → General → Your apps → SDK setup and configuration.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- SMTP (отправка писем) ---
SMTP_USER=
SMTP_PASS=

# --- Прочее ---
PORT=7575
NODE_ENV=development
REDIS_URL=redis://localhost:6379
SITE_URL=https://rhy.thm.su
