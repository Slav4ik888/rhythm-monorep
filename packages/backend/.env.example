# Шаблон переменных окружения бэкенда.
# Локально: скопируйте в .env и заполните: cp .env.example .env
# На сервере: в /etc/rhythm/rhythm-server.env (его читает systemd, см. rhythm-server.service,
#   EnvironmentFile=) кладите ТОЛЬКО секреты (FIREBASE_*, SMTP_*, LOGS_PASS). Общие переменные
#   (PORT/NODE_ENV/REDIS_URL/SITE_URL) уже заданы в rhythm-server.service через Environment=,
#   дублировать их в env-файле на сервере не нужно.

# --- Firebase Admin SDK (Service Account) — только для локального dev ---
# На сервере креды Admin SDK читаются из JSON-файла (GOOGLE_APPLICATION_CREDENTIALS),
# а не из этих переменных (privateKey нельзя держать в systemd EnvironmentFile).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# ВАЖНО: приватный ключ на ОДНОЙ строке, переносы строк — литеральные \n (только для dotenv).
FIREBASE_PRIVATE_KEY=

# --- Firebase web-конфиг (client SDK, используется бэкендом для firebase/auth) ---
# Firebase Console → Project settings → General → Your apps → SDK setup and configuration.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- SMTP (отправка писем) ---
SMTP_USER=
SMTP_PASS=

# --- Логи (пароль доступа к /loggers/*) ---
LOGS_PASS=

# --- Служебные пользователи (логи которых не пишутся в url.log) ---
# ID Firebase-пользователей через запятую. Если не задано — используются ID по умолчанию
# (см. DEFAULT_INTERNAL_USERS в app/config/index.ts).
INTERNAL_USERS=

# --- Прочее ---
PORT=7575
NODE_ENV=development
REDIS_URL=redis://localhost:6379
SITE_URL=https://rhy.thm.su
