rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Вторая линия защиты: вся работа с Firestore идёт через бэкенд (Admin SDK),
      // поэтому прямые клиентские обращения запрещены полностью.
      allow read, write: if false;
    }
  }
}
