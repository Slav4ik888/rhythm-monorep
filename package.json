{
  "name": "rhythm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/frontend",
    "packages/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "bash dev.sh",
    "build": "npm run build -w packages/backend && npm run build -w packages/frontend",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "npm test -w packages/backend && npm test -w packages/frontend",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,json,scss,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,scss,css,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,scss,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-slavchik888-plugin": "^0.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "typescript": "5.5.4",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-fastify": "^11.1.29",
    "fastify": "^5.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
